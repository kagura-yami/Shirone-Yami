<!-- Cross-document language visits keep the old snapshot until fonts and header
     islands are ready. Ordinary Swup visits retain their existing lifecycle. -->
<style is:inline>
	@view-transition { navigation: auto; }
	::view-transition-group(root) { animation-duration: var(--m3e-duration-short, 150ms); }
	html.motion-reduced::view-transition-group(root) { animation-duration: 0s; }
	html[data-language-loading]::view-transition-old(root) {
		animation: language-hold 1s linear infinite;
		z-index: 2;
	}
	html[data-language-loading]::view-transition-new(root) { animation: none; opacity: 0; }
	@keyframes language-hold { from, to { opacity: 1; } }
	/* The document transition owns language navigation, rather than replaying
	   each component's initial entrance and revealing the header in stages. */
	html[data-language-navigation] .onload-animation {
		animation: none;
		opacity: 1;
		transform: none;
	}
	@media (prefers-reduced-motion: reduce) {
		::view-transition-group(root) { animation-duration: 0s; }
	}
</style>
<script is:inline>
	{
		const root = document.documentElement;
		let languageVisit = false;
		try {
			const destination = sessionStorage.getItem('shirone:language-navigation');
			sessionStorage.removeItem('shirone:language-navigation');
			languageVisit = destination === location.pathname + location.search;
		} catch { /* Navigation also works when storage is unavailable. */ }
		if (languageVisit) {
			root.setAttribute('data-language-navigation', '');
			root.setAttribute('data-language-loading', '');
			const release = () => root.removeAttribute('data-language-loading');
			// Never leave a snapshot covering the page after a failed asset request.
			const timeout = setTimeout(release, 3000);
			document.addEventListener('DOMContentLoaded', async () => {
				const islands = [...document.querySelectorAll('#navbar astro-island[ssr]')];
				const hydrated = Promise.all(islands.map(island => new Promise(resolve => {
					island.addEventListener('astro:hydrate', resolve, { once: true });
					if (!island.hasAttribute('ssr')) resolve();
				})));
				await Promise.allSettled([document.fonts.ready, hydrated]);
				clearTimeout(timeout);
				release();
			}, { once: true });
		}
		window.addEventListener('pagereveal', event => {
			if (!languageVisit) event.viewTransition?.skipTransition();
		});
		window.addEventListener('pageshow', event => {
			if (event.persisted) root.removeAttribute('data-language-loading');
		});
	}
</script>
